              "raw": "{\n  \"job_title\": \"Senior Software Engineer\",\n  \"department\": \"Engineering\",\n  \"seniority\": \"Senior\",\n  \"required_skills\": [\"Python\", \"React\", \"PostgreSQL\"],\n  \"key_responsibilities\": [\"Build backend APIs\", \"Code review\", \"Mentor juniors\"]\n}"
            }
          }
        },
        {
          "name": "Score CV Values",
          "request": {
            "method": "POST",
