              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cv_text\": \"John Smith - 10 years experience in software engineering...\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Meetings & Briefings",
      "item": [
        {
          "name": "Get Meetings",
          "request": {
            "method": "GET",
