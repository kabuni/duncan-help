              "raw": "{\n  \"briefing_id\": \"BRIEFING_ID\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Storage",
      "item": [
        {
          "name": "Download Blob (Authenticated Proxy)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/azure-blob-api/download?path=projects/PROJECT_ID/filename.pdf",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "List Blobs",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/azure-blob-api/list?prefix=projects/",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
