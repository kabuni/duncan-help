{
  "info": {
    "name": "Duncan API",
    "description": "Kabuni's Duncan platform FastAPI backend",
    "_postman_id": "duncan-api-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/signup",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@kabuni.com\",\n  \"password\": \"password123\",\n  \"display_name\": \"Test User\",\n  \"role_title\": \"Developer\",\n  \"department\": \"Engineering\"\n}"
            }
          }
        },
        {
          "name": "Sign In",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.collectionVariables.set('access_token', json.access_token);",
                  "  pm.collectionVariables.set('refresh_token', json.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/signin",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@kabuni.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Sign Out",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/signout",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/change-password",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"password123\",\n  \"new_password\": \"newpassword456\"\n}"
            }
          }
        },
        {
          "name": "Request Password Reset",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/password-reset/request",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@kabuni.com\"\n}"
            }
          }
        },
        {
          "name": "[Admin] List Pending Users",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/admin/pending-users",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "[Admin] Approve User",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/admin/approve/USER_ID",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "[Admin] Set User Roles",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/admin/roles/USER_ID",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roles\": [\"user\"]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Norman Chat (SSE Stream)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/norman-chat",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "text/event-stream" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"What are my current workstream tasks?\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Generate Chat Title",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/generate-chat-title",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"What are my overdue tasks?\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Get General Chats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/general-chats",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Create General Chat",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/general-chats",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New Conversation\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Get Projects",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/get-projects",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/create-project",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Q1 2026 Launch\",\n  \"description\": \"Product launch project\",\n  \"color\": \"#6366f1\"\n}"
            }
          }
        },
        {
          "name": "Get Project Chats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/get-project-chats?project_id=PROJECT_ID",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Create Project Chat",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/create-project-chat?project_id=PROJECT_ID",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Planning Session\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Workstreams",
      "item": [
        {
          "name": "Get Workstream Cards",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/workstream-cards",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Create Workstream Card",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/workstream-cards",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"project_id\": \"PROJECT_ID\",\n  \"title\": \"Design landing page\",\n  \"description\": \"Create new landing page designs\",\n  \"status\": \"green\",\n  \"due_date\": \"2026-05-30\"\n}"
            }
          }
        },
        {
          "name": "Update Workstream Card",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/workstream-cards/CARD_ID",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"yellow\",\n  \"description\": \"Updated description\"\n}"
            }
          }
        },
        {
          "name": "Check Overdue Tasks",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/check-overdue-tasks",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
